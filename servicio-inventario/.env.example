# Copiar a .env y ajustar. Valores por defecto para correr en la máquina con el kit arriba.
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/inventario
BROKER=localhost:19092
API_PORT=8000
# CONTRACT_DIR=../contract/schemas        # por defecto se busca junto al kit
# PENDING_MAX_AGE_SECONDS=21600           # espera máxima de un evento sin su pieza/orden
# REPLAY_API_JOURNAL=1                    # reaplicar operaciones de la API al reconstruir
LOG_LEVEL=INFO
